# Copy to .env.local for development; never commit real credentials.
# Use a development self-hosted Supabase instance to avoid changing prod data.
NEXT_PUBLIC_SUPABASE_URL=https://api.cycleconnect.cc
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI text: Gemini -> OpenRouter -> Ollama -> DeepSeek (optional providers).
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.5-flash,gemini-2.5-flash
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# Ollama also serves bge-m3 embeddings for semantic search.
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b

# Optional maps and elevation data.
NEXT_PUBLIC_MAPTILER_KEY=
SRTM_TILE_DIR=
SRTM_RESOLUTION=srtm1

# Telegram login / linking. Edge functions need their own Compose env.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
# Leave unset locally unless a SOCKS tunnel is available.
SOCKS_PROXY=

# Internal cron / email-send shared secret; match Compose and DB Vault on prod.
CRON_SECRET=
SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=CycleConnect
SMTP_FROM_EMAIL=noreply@cycleconnect.cc

# Strava is currently disabled in route handlers, regardless of credentials.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=
